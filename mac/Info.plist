<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>JIS Moonshot</string>
	<key>CFBundleExecutable</key>
	<string>JISMoonshot</string>
	<key>CFBundleIdentifier</key>
	<string>me.sjun.inputmethod.JISMoonshot</string>
	<key>CFBundleName</key>
	<string>JIS Moonshot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>InputMethodConnectionName</key>
	<string>me.sjun.inputmethod.JISMoonshot_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>JKInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>JKInputController</string>
	<key>ComponentInputModeDict</key>
	<dict>
		<!-- One input mode per engine mode (spec §3.6, §8.2, docs/moonshot.md §2): Mode A (.2Set,
		     Korean script) and JIS Kana (.A_KANA, Japanese script); the English modes are added at
		     build time (tools/add-english-mode.sh). Never rename an ID: tools select modes by it. Each
		     has its own badge (docs/logo), macOS draws them as templates (TISIconIsTemplate). -->
		<key>tsInputModeListKey</key>
		<dict>
			<key>me.sjun.inputmethod.JISMoonshot.2Set</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>me.sjun.inputmethod.JISMoonshot.2Set</string>
				<key>TISIntendedLanguage</key>
				<string>ko</string>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>mode-a.png</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>mode-a.png</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smKorean</string>
			</dict>
			<key>me.sjun.inputmethod.JISMoonshot.A_KANA</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>me.sjun.inputmethod.JISMoonshot.A_KANA</string>
				<key>TISIntendedLanguage</key>
				<string>ja</string>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>mode-a-kana.png</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>mode-a-kana.png</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<false/>
				<!-- Korean script, not Japanese: macOS's かな only selects the Japanese script's primary
				     mode (the かな proxy) when Japanese isn't selected already, so in a Japanese-script
				     JIS Kana, かな did nothing. -->
				<key>tsInputModeScriptKey</key>
				<string>smKorean</string>
			</dict>
			<!-- The かな proxy (docs/moonshot.md §7): the primary Japanese-script mode, so macOS's own
			     かな selects it without any permission. It's never left selected: the input method
			     reroutes it to Mode A (or forces Korean there) at once, and types as Mode A meanwhile. -->
			<key>me.sjun.inputmethod.JISMoonshot.KanaKey</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>me.sjun.inputmethod.JISMoonshot.KanaKey</string>
				<key>TISIntendedLanguage</key>
				<string>ja</string>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>mode-a.png</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>mode-a.png</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smJapanese</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>me.sjun.inputmethod.JISMoonshot.2Set</string>
			<string>me.sjun.inputmethod.JISMoonshot.A_KANA</string>
			<string>me.sjun.inputmethod.JISMoonshot.KanaKey</string>
		</array>
	</dict>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<key>TISInputSourceID</key>
	<string>me.sjun.inputmethod.JISMoonshot</string>
	<key>TISIntendedLanguage</key>
	<string>ko</string>
	<key>tsInputMethodIconFileKey</key>
	<string>moonshot.png</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hang</string>
		<string>Hira</string>
		<string>Kana</string>
	</array>
</dict>
</plist>
